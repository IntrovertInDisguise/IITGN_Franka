<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>franka_kdl_broadcaster</name>
  <version>0.0.0</version>

  <description>Publishes Franka end-effector and tool poses using KDL forward kinematics.</description>
  <maintainer email="debojit.das@iitgn.ac.in">iitgn-robotics</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>urdf_parser_py</depend>
  <depend>kdl_parser_py</depend>

  <exec_depend>python3</exec_depend>
  <exec_depend>python3-pykdl</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
